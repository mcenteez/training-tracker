# Training Tracker environment template
# Keep real values in environment-specific secret stores only.

# Local development
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
# Clerk remains the default. Use `npm run dev:local` for local personas.
AUTH_MODE=clerk

# Preview/staging (example names for secret managers)
# PREVIEW_DATABASE_URL=postgresql://user:password@preview-host/database?sslmode=require
# PREVIEW_NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_preview_replace_me
# PREVIEW_CLERK_SECRET_KEY=sk_test_preview_replace_me

# Production (example names for secret managers)
# PRODUCTION_DATABASE_URL=postgresql://user:password@prod-host/database?sslmode=require
# PRODUCTION_NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_me
# PRODUCTION_CLERK_SECRET_KEY=sk_live_replace_me